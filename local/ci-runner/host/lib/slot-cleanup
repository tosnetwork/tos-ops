#!/bin/bash
# Root-owned, fixed: remove everything a CI slot's VM left. Runs as
# ExecStopPost=+ of tos-ci-vm@.service, after every exit.
set -uo pipefail

slot=${1:-}
[[ $slot =~ ^[123]$ ]] || { echo "slot-cleanup: invalid slot" >&2; exit 2; }

STORE=/var/lib/tos-ci
STATE=$STORE/state
dir=$STORE/slot$slot
ok=1

ip link del "tci$slot" 2> /dev/null || true
if [[ -L $dir ]]; then rm -f -- "$dir" || ok=0; fi
rm -rf --one-file-system -- "$dir" || ok=0
rm -f -- "/run/tos-ci/slot$slot/admission.sock" || ok=0
[[ ! -e $dir && ! -e /sys/class/net/tci$slot ]] || ok=0

if [[ $ok == 1 ]]; then
  install -d -m 0755 -o root -g root "$STATE"
  touch "$STATE/cleanup-$slot"
  echo "slot $slot cleaned"
else
  echo "slot-cleanup: slot $slot cleanup incomplete" >&2
  exit 1
fi

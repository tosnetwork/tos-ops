#!/bin/bash
# CI VM network isolation.
#   up       resolve the host's public IPv4 (or use the last one recorded),
#            render the rules with it and load them in one nft transaction;
#            refuse when no address is known, so no VM can start unprotected
#   refresh  resolve again; on success replace the set's element in one
#            transaction, on failure leave the rules untouched
#   down     remove the rules
# TOS_CI_RESOLVER overrides the resolver (tests only).
set -euo pipefail

TEMPLATE=/usr/lib/tos-ci/tos-ci.nft
RECORD_DIR=/var/lib/tos-ci-net
RECORD=$RECORD_DIR/public4
RESOLVER=${TOS_CI_RESOLVER:-resolver1.opendns.com}
valid() { [[ $1 =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]]; }

resolve() {
  local addr
  addr=$(dig +short +time=3 +tries=2 -4 myip.opendns.com "@$RESOLVER" 2> /dev/null | tail -1 || true)
  valid "$addr" && printf '%s' "$addr"
}

record() {
  install -d -m 0700 -o root -g root "$RECORD_DIR"
  printf '%s\n' "$1" > "$RECORD.tmp"
  chmod 0600 "$RECORD.tmp"
  mv "$RECORD.tmp" "$RECORD"
}

docker_user_rules() {
  # The iptables-nft FORWARD chain has policy drop (docker); CI traffic must
  # be accepted there too. DOCKER-USER is the chain docker leaves to us.
  iptables -nL DOCKER-USER > /dev/null 2>&1 || return 0
  iptables -C DOCKER-USER -i tosci0 -o eno1 -j ACCEPT 2> /dev/null \
    || iptables -I DOCKER-USER 1 -i tosci0 -o eno1 -j ACCEPT
  iptables -C DOCKER-USER -i eno1 -o tosci0 -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT 2> /dev/null \
    || iptables -I DOCKER-USER 1 -i eno1 -o tosci0 -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
}

case "${1:-up}" in
  up)
    addr=$(resolve || true)
    if [[ -z $addr && -s $RECORD ]]; then
      addr=$(cat "$RECORD")
      echo "public IPv4 not resolved; using the recorded address" >&2
    fi
    valid "${addr:-}" || { echo "no public IPv4 known; refusing to load CI network rules" >&2; exit 1; }
    rendered=$(mktemp /run/tos-ci-nft.XXXXXX)
    trap 'rm -f "$rendered"' EXIT
    sed "s/@PUBLIC4@/$addr/" "$TEMPLATE" > "$rendered"
    nft -f "$rendered"
    record "$addr"
    docker_user_rules
    echo "CI network rules loaded"
    ;;
  refresh)
    addr=$(resolve || true)
    valid "${addr:-}" || { echo "public IPv4 not resolved; rules left unchanged" >&2; exit 1; }
    nft -f - <<< "flush set inet tos_ci host_public4
add element inet tos_ci host_public4 { $addr }"
    record "$addr"
    echo "public IPv4 refreshed"
    ;;
  down)
    nft delete table inet tos_ci 2> /dev/null || true
    nft delete table bridge tos_ci_l2 2> /dev/null || true
    iptables -D DOCKER-USER -i tosci0 -o eno1 -j ACCEPT 2> /dev/null || true
    iptables -D DOCKER-USER -i eno1 -o tosci0 -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT 2> /dev/null || true
    ;;
  *) echo "usage: net-setup up|refresh|down" >&2; exit 2 ;;
esac

#!/usr/bin/python3 -I
"""Bound the verification-mode audit archive before a CI slot's VM starts.

Runs as root from tos-ci-vm@.service (ExecStartPre=+), before QEMU, so the
lifetime about to start has no archive file yet. Under the archive's global
lock it removes the oldest closed archive files until closed files total at
most CLOSED_BUDGET bytes and number at most MAX_CLOSED.

A file is closed when no writer holds its lifetime lock: an exclusive
non-blocking flock on it succeeds. An active file is never removed. If the
bound cannot be reached, the VM must not start, so this exits non-zero.

With three slots and a writer cap of 1 GiB per lifetime, the archive never
exceeds CLOSED_BUDGET + 3 GiB: files are created only by a lifetime that
started after this pass.
"""

from __future__ import annotations

import fcntl
import os
import sys
from pathlib import Path

ARCHIVE = Path("/var/lib/tos-ci/audit")
CLOSED_BUDGET = 5 * 2**30
MAX_CLOSED = 200


def closed(path: Path) -> bool:
    """True if no writer holds this file's lifetime lock."""
    with open(path, "rb") as f:
        try:
            fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return False
        fcntl.flock(f, fcntl.LOCK_UN)
        return True


def prune(archive: Path, budget: int, max_closed: int) -> list[str]:
    """Remove the oldest closed files down to the bound; return their names.

    Raises SystemExit if the bound cannot be reached.
    """
    with open(archive / ".lock", "rb") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        files = []
        for path in archive.glob("slot[123]/*.log"):
            if path.is_symlink() or not path.is_file():
                raise SystemExit(f"audit-prune: unexpected entry {path}")
            if closed(path):
                files.append((path.stat().st_mtime, path))
        files.sort()
        total = sum(path.stat().st_size for _, path in files)
        removed = []
        while files and (total > budget or len(files) > max_closed):
            _, oldest = files.pop(0)
            size = oldest.stat().st_size
            try:
                oldest.unlink()
            except OSError as error:
                raise SystemExit(f"audit-prune: cannot remove {oldest}: {error}") from None
            total -= size
            removed.append(oldest.name)
        if total > budget or len(files) > max_closed:
            raise SystemExit(f"audit-prune: closed archives still {total} bytes in {len(files)} files")
        return removed


def main(argv: list[str]) -> int:
    if len(argv) != 1 or argv[0] not in ("1", "2", "3"):
        print("usage: audit-prune SLOT", file=sys.stderr)
        return 2
    if os.geteuid() != 0:
        print("audit-prune: run as root", file=sys.stderr)
        return 2
    for name in prune(ARCHIVE, CLOSED_BUDGET, MAX_CLOSED):
        print(f"audit-prune: removed {name}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

#!/usr/bin/python3 -I
"""Write one CI VM lifetime's audit stream to the archive.

Runs as tos-ci-slot<N> in tos-ci-audit@<N>.service, activated when that
slot's QEMU connects to the listening socket systemd passes as fd 3. The
service runs under `prlimit --fsize=<cap>`, so the kernel stops the file at
the cap. SIGXFSZ is ignored, so the cap arrives as EFBIG. At the cap the
writer keeps what fits, stops reading and stays alive: virtio-serial flow
control then blocks the guest's forwarder, its closing marker never arrives,
and the run is invalid. It never exits before the VM; BindsTo ends it.

The file is created on the first byte, under the archive's global lock and
with the lifetime lock taken before that lock is released, so the pruner
never sees an active file without its lock. A lifetime with no audit stream
leaves no file.
"""

from __future__ import annotations

import datetime as dt
import errno
import fcntl
import os
import signal
import socket
import sys
from pathlib import Path

ARCHIVE = Path("/var/lib/tos-ci/audit")
LISTEN_FD = 3


def log(message: str) -> None:
    print(f"audit-writer: {message}", flush=True)


def open_archive(directory: Path, lock_path: Path) -> int:
    """Create this lifetime's file and hold its lifetime lock."""
    stamp = dt.datetime.now(dt.timezone.utc).strftime("%Y%m%dT%H%M%S.%fZ")
    with open(lock_path, "rb") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        fd = os.open(directory / f"{stamp}.log", os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC, 0o600)
        fcntl.flock(fd, fcntl.LOCK_SH)
    return fd


def write_all(fd: int, data: bytes) -> bool:
    """Write every byte; False once the file reached its size limit."""
    view = memoryview(data)
    while view:
        try:
            written = os.write(fd, view)
        except OSError as error:
            if error.errno == errno.EFBIG:
                return False
            raise
        view = view[written:]
    return True


def serve(conn: socket.socket, directory: Path, lock_path: Path) -> None:
    fd = -1
    while True:
        chunk = conn.recv(1 << 16)
        if not chunk:
            log("stream ended")
            return
        if fd < 0:
            fd = open_archive(directory, lock_path)
            log("archive opened")
        if not write_all(fd, chunk):
            log("audit archive at its cap")
            # Hold the connection unread until the VM ends.
            while True:
                signal.pause()


def main(argv: list[str]) -> int:
    if len(argv) != 1 or argv[0] not in ("1", "2", "3"):
        print("usage: audit-writer SLOT", file=sys.stderr)
        return 2
    signal.signal(signal.SIGXFSZ, signal.SIG_IGN)
    if os.environ.get("LISTEN_FDS") != "1" or os.environ.get("LISTEN_PID") != str(os.getpid()):
        print("audit-writer: expects exactly one socket from systemd", file=sys.stderr)
        return 2
    listener = socket.socket(fileno=LISTEN_FD)
    conn, _ = listener.accept()
    listener.close()
    serve(conn, ARCHIVE / f"slot{argv[0]}", ARCHIVE / ".lock")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

[Unit]
Description=TOS CI audit stream writer, slot %i
Documentation=file:///usr/lib/tos-ci/README.md
Requires=tos-ci-audit@%i.socket var-lib-tos\x2dci.mount
After=tos-ci-audit@%i.socket var-lib-tos\x2dci.mount
# Ends with the VM, never before it.
BindsTo=tos-ci-vm@%i.service
After=tos-ci-vm@%i.service

[Service]
Type=simple
Slice=tos-ci.slice
User=tos-ci-slot%i
Group=tos-ci-slot%i
# One lifetime's archive file is at most this many bytes; the kernel enforces it.
Environment=CAP=1073741824
ExecStart=/usr/bin/prlimit --fsize=${CAP} -- /usr/bin/python3 -I /usr/lib/tos-ci/audit-writer %i
Restart=no
StandardOutput=journal
StandardError=journal

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/tos-ci/audit/slot%i
UMask=0077

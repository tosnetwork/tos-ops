[Unit]
Description=TOS CI DHCP and DNS on tosci0 only
Documentation=file:///usr/lib/tos-ci/README.md
Requires=tos-ci-net.service
After=tos-ci-net.service systemd-networkd.service

[Service]
Type=simple
# Bound to the bridge address only; upstream resolution through the host's
# resolver list. Fixed leases per slot MAC. Answers that point into private
# ranges are refused (stop-dns-rebind).
ExecStart=/usr/sbin/dnsmasq --keep-in-foreground --conf-file=/dev/null \
  --interface=tosci0 --bind-interfaces --except-interface=lo \
  --listen-address=10.231.37.1 --no-hosts --stop-dns-rebind \
  --resolv-file=/run/systemd/resolve/resolv.conf \
  --dhcp-authoritative --dhcp-range=10.231.37.10,10.231.37.99,255.255.255.0,1h \
  --dhcp-option=option:router,10.231.37.1 --dhcp-option=option:dns-server,10.231.37.1 \
  --dhcp-host=52:54:00:7c:00:01,10.231.37.11 --dhcp-host=52:54:00:7c:00:02,10.231.37.12 \
  --dhcp-host=52:54:00:7c:00:03,10.231.37.13 --dhcp-host=52:54:00:7c:00:20,10.231.37.20 \
  --dhcp-leasefile=/run/tos-ci/dnsmasq.leases --pid-file= --user=nobody --group=nogroup
Restart=on-failure

[Install]
WantedBy=multi-user.target

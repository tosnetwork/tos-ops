[Unit]
Description=TOS CI virtual machines (aggregate limits)
Documentation=file:///usr/lib/tos-ci/README.md

[Slice]
# Hard aggregate bounds for every CI VM together. Three slots at 17G fit;
# the supervisor admits at most three, and this is the backstop.
MemoryMax=54G
MemorySwapMax=0
# Physical cores 72-95 and their SMT siblings 168-191, on NUMA node1.
# No CI vCPU thread may run on the 144 logical CPUs left to the host.
AllowedCPUs=72-95,168-191
TasksMax=12288

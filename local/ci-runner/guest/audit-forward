#!/usr/bin/python3 -I
"""Forward the audit log, from its first byte, to the host's audit port.

Verification mode only (root, tos-ci-audit-forward.service). Writes to the
virtio-serial port block while the host side is slow, so nothing is dropped.
After each completed write the forwarded byte offset is recorded, which
audit-close waits on before the VM powers off.

The log never rotates in verification mode. A changed inode or a shrinking
file means rotation or tampering; any failure is reported on the console and
ends forwarding, which makes the run invalid.
"""

from __future__ import annotations

import os
import subprocess
import sys
import time

LOG = "/var/log/audit/audit.log"
PORT = "/dev/virtio-ports/org.tosnetwork.audit"
ACK = "/run/tos-ci-audit-forwarded"


def console(message: str) -> None:
    subprocess.run(["logger", "-p", "user.notice", "-t", "tos-ci", message], check=False)


def acknowledge(offset: int) -> None:
    tmp = f"{ACK}.tmp"
    with open(tmp, "w") as f:
        f.write(f"{offset}\n")
    os.replace(tmp, ACK)


def forward(log_path: str, port_path: str) -> None:
    port = os.open(port_path, os.O_WRONLY)
    with open(log_path, "rb", buffering=0) as log:
        inode = os.fstat(log.fileno()).st_ino
        offset = 0
        acknowledge(offset)
        while True:
            chunk = log.read(1 << 16)
            if chunk:
                view = memoryview(chunk)
                while view:
                    view = view[os.write(port, view):]
                offset += len(chunk)
                acknowledge(offset)
                continue
            current = os.stat(log_path)
            if current.st_ino != inode or current.st_size < offset:
                raise RuntimeError("rotation")
            time.sleep(0.05)


def main() -> int:
    try:
        forward(LOG, PORT)
    except Exception as error:  # every failure ends the evidence, visibly
        console(f"audit-forward failed: {type(error).__name__}: {error}")
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())

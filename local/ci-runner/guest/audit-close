#!/usr/bin/python3 -I
"""Close the audit stream: one nonce-bound end marker, then a bounded drain.

Verification mode only, root. Called on the end-of-job path (end-job) and
from the forwarder unit's ExecStop; whichever runs first emits the markers,
every later call reuses the recorded offset, so there is exactly one end
marker per lifetime.

1. Emit a status marker carrying the kernel's lost count, then the end
   marker carrying the VM nonce.
2. Find the end marker in audit.log; record the offset just past its line.
3. Wait until the forwarder has acknowledged that offset.

Within DEADLINE seconds, or the console reports `audit drain timeout` and the
run is invalid.
"""

from __future__ import annotations

import fcntl
import re
import subprocess
import sys
import time
from pathlib import Path

LOG = Path("/var/log/audit/audit.log")
ACK = Path("/run/tos-ci-audit-forwarded")
LOCK = Path("/run/tos-ci-audit-close.lock")
STATE = Path("/run/tos-ci-audit-close.state")
NONCE = Path("/etc/tos-ci/vm-nonce")
DEADLINE = 30.0


def console(message: str) -> None:
    subprocess.run(["logger", "-p", "user.notice", "-t", "tos-ci", message], check=False)


def read_int(path: Path) -> int | None:
    try:
        return int(path.read_text().strip())
    except (OSError, ValueError):
        return None


def marker_end(log: Path, needle: bytes) -> int | None:
    """Offset just past the line containing needle, or None."""
    data = log.read_bytes()
    at = data.find(needle)
    if at < 0:
        return None
    newline = data.find(b"\n", at)
    return None if newline < 0 else newline + 1


def emit_markers(nonce: str) -> None:
    status = subprocess.run(["auditctl", "-s"], capture_output=True, text=True, check=True).stdout
    lost = re.search(r"^lost (\d+)$", status, re.M)
    backlog = re.search(r"^backlog (\d+)$", status, re.M)
    if not lost:
        raise RuntimeError("auditctl -s has no lost count")
    subprocess.run(["auditctl", "-m", f"tos-ci-audit-status lost={lost.group(1)} "
                    f"backlog={backlog.group(1) if backlog else 'unknown'}"], check=True)
    subprocess.run(["auditctl", "-m", f"tos-ci-audit-end nonce={nonce}"], check=True)


def close(deadline: float) -> bool:
    with open(LOCK, "a+") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        target = read_int(STATE)
        if target is None:
            nonce = NONCE.read_text().strip()
            emit_markers(nonce)
            needle = f"tos-ci-audit-end nonce={nonce}".encode()
            while (target := marker_end(LOG, needle)) is None:
                if time.monotonic() > deadline:
                    return False
                time.sleep(0.05)
            STATE.write_text(f"{target}\n")
        while (read_int(ACK) or 0) < target:
            if time.monotonic() > deadline:
                return False
            time.sleep(0.05)
        return True


def main() -> int:
    deadline = time.monotonic() + DEADLINE
    try:
        drained = close(deadline)
    except Exception as error:  # a failed close is an invalid run, said so
        console(f"audit drain failed: {type(error).__name__}: {error}")
        return 1
    if not drained:
        console("audit drain timeout")
        return 1
    console("audit drained")
    return 0


if __name__ == "__main__":
    sys.exit(main())

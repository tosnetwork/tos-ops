[Unit]
Description=Forward the audit log to the host (verification mode)
# Started by start-job only when auditing is on. Ordered after auditd and
# before the runner, so at shutdown it stops after the runner and before
# auditd; its ExecStop closes the stream if end-job has not.
After=auditd.service
Before=tos-ci-runner.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 -I /usr/lib/tos-ci-guest/audit-forward
ExecStop=/usr/bin/python3 -I /usr/lib/tos-ci-guest/audit-close
TimeoutStopSec=45
Restart=no

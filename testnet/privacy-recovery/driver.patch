+    )
+    .map_err(fail("recipient boc"))?;
+    let si = chain_block::StateInit::with_code_and_data(code, data);
+    let hash = si
+        .write_to_new_cell()
+        .and_then(|b| b.into_cell())
+        .map_err(fail("recipient init"))?
+        .hash(0);
+    if hash.to_hex_string() != "c3a3c27df46f83e58959b217be4e2fee5f4070fe1119fc34f2035b2e64b470c2" {
+        return Err("rehearsal recipient StateInit differs from frozen address".into());
+    }
+    let addr =
+        chain_block::MsgAddressInt::with_params(0, hash).map_err(fail("recipient address"))?;

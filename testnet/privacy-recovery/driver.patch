+def recovery_post_matches(before, after, planned, result, recipient):
+    """Accept exactly one authenticated, successful withdrawal+bounce pair.
+
+    Root correctness comes from core replay of original outbound body, inbound
+    bounce and note append, checked against both peers' complete getters.
+    Here pin that recovery to THIS action and check all state deltas.
+    """
+    events = after["events"][len(before["events"]):]
+    if len(events) != 2 or events[0]["hash"] != result.get("pool_tx", next(iter(result.get("delivered", {}).values()), {}).get("pool_tx")):
+        return False
+    if [e["kind"] for e in events] != ["withdraw", "bounce"] or not all(e["applied"] for e in events):
+        return False
+    previous = before["summary"]["recoveries"]
+    recoveries = after["summary"]["recoveries"]
+    if len(recoveries) != len(previous)+1 or recoveries[:-1] != previous:
+        return False
+    recovered = recoveries[-1]
+    amount = int(recovered["minted_amount"])
+    state = after["verified_state"]
+    minted = int(amount > 0)
+    return (recovered["recipient"] == recipient and recovered["consumed"] is True
+            and amount >= 0 and (recovered["minted_leaf"] == int(planned["commitment_next_index"]) if minted else recovered["minted_leaf"] is None)
+            and int(state["commitment_next_index"]) == int(planned["commitment_next_index"])+minted
+            and int(state["native_liability"]) == int(planned["native_liability"])+amount
+            and int(state["reserved_recovery_leaves"]) == int(planned["reserved_recovery_leaves"])-1
+            and all(state[k] == planned[k] for k in ("nullifier_root", "nullifier_next_index")))
+

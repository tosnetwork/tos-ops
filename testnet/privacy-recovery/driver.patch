+    /// Match a protocol bounce to an authenticated earlier outbound payout.
+    /// Current-price charge is explicit; complete replay must still equal all getters.
+    pub fn apply_recovery(
+        &mut self,
+        original_hash: &str,
+        sender: &str,
+        returned: u128,
+        utime: u32,
+    ) -> Result<()> {
+        let index = self
+            .pending_recoveries
+            .iter()
+            .position(|p| p.body_hash == original_hash)
+            .ok_or("bounce has no authenticated original payout")?;
+        let pending = self.pending_recoveries[index].clone();
+        if pending.consumed || pending.recipient != sender || returned > pending.payout_value {
+            return Err("replayed bounce, wrong sender or excessive returned value".into());
+        }
+        let charge = self.recovery_charge.ok_or("recovery charge not supplied")?;
+        if charge == 0 {
+            return Err("zero recovery charge".into());
+        }
+        self.reserved_recovery = self
+            .reserved_recovery
+            .checked_sub(1)
+            .ok_or("no recovery reservation")?;
+        self.pending_recoveries[index].consumed = true;
+        if returned <= charge {
+            return Ok(());
+        }
+        self.outputs
+            .retain(|o| !(o.leaf.is_none() && o.observed.output_data == pending.payload));
+        let amount = returned - charge;
+        let data_hash = wire::output_data_hash(&pending.payload);
+        let note_body = notes::note_body_commitment(pending.owner, Fr::from(amount), data_hash);
+        self.preserve(utime);
+        let leaf = self.append(note_body)?;
+        self.liability = self
+            .liability
+            .checked_add(amount)
+            .ok_or("recovery liability overflow")?;
+        self.pending_recoveries[index].minted_amount = amount;
+        self.pending_recoveries[index].minted_leaf = Some(leaf);
+        for slot in 0..3u8 {
+            self.outputs.push(Output {
+                leaf: Some(leaf),
+                observed: ObservedOutput {
+                    slot,
+                    output_data: pending.payload.clone(),
+                    chain: ChainSlot {
+                        output_data_hash: data_hash,
+                        note_body,
+                        recovered: Some(amount),
+                    },
+                },
+            });
         }
         Ok(())
     }

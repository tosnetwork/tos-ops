[Unit]
Description=TOS public testnet election task (tosctl service)
Documentation=file:///opt/tos-testnet/CEREMONY.md
After=network-online.target tos-testnet-validator.service
Wants=network-online.target

[Service]
User=root
Group=root
UMask=0077
WorkingDirectory=/var/lib/tos-ctl
EnvironmentFile=/etc/tos/tosctl.env
ExecStart=/usr/local/bin/tosctl service
# Always, not on-failure: tosctl service exits 0 when it cannot read the chain
# at start (the validator's JSON-RPC is not up yet after a reboot), and
# on-failure then left the task dead through an election (memo
# public-testnet/EPOCH-1-FINDINGS.md, E1-06).
Restart=always
RestartSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=multi-user.target

[Unit]
Description=TOS public testnet full node (lite server and JSON-RPC)
Documentation=file:///opt/tos-testnet/README.md
After=network-online.target time-sync.target
Wants=network-online.target

[Service]
User=tos
Group=tos
UMask=0077
WorkingDirectory=/var/lib/tos/fullnode
# The lite server port comes from config.json (testnet-operator.py configure).
# JSON-RPC listens on loopback; publish it only through an authenticating
# reverse proxy, or switch to --json-rpc-readonly on a public address.
# RocksDB caches capped at 1 GiB each (owner decision 2026-10-15; memo
# public-testnet E23-18). CellDb V2 otherwise raises its block cache to
# max(1 GiB, cell cache entries x 5000), about 4.66 GiB with the defaults, and
# it does so even when --celldb-cache-size is smaller unless
# --celldb-cache-min-size is set too, so both flags carry the cap. The shared
# block cache of the other databases defaults to 1 GiB; it is set here so the
# cap does not depend on an engine default.
Environment=TOS_ROCKSDB_BLOCK_CACHE_SIZE=1073741824
ExecStart=/usr/local/bin/validator-engine \
  -C /etc/tos/global-config.json \
  -D /var/lib/tos/fullnode \
  -l /var/log/tos/fullnode/node.log \
  -t 16 \
  --state-ttl 86400 --archive-ttl 2592000 \
  --celldb-cache-size 1073741824 --celldb-cache-min-size 1073741824 \
  --json-rpc-address 127.0.0.1:8081 \
  --exporter-address 127.0.0.1:9100
Restart=on-failure
RestartSec=10
RestartPreventExitStatus=2
KillMode=control-group
TimeoutStopSec=120
LimitNOFILE=1572864
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/tos/fullnode /var/log/tos/fullnode
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
